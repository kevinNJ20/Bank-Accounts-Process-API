				</ee:transform>
				<set-variable value="400" doc:name="httpStatus" doc:id="223a9d66-b7f5-45ac-958b-19c0eede8250" variableName="httpStatus" />
			</on-error-propagate>
			<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate2" doc:id="96d8e329-f881-4d12-ae79-505c79d865f1" type="APIKIT:NOT_ACCEPTABLE" >

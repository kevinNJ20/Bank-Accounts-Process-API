			<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate4" doc:id="327a9e12-8408-4e1d-b619-a7293785bd53" type="APIKIT:METHOD_NOT_ALLOWED" >
				<ee:transform doc:name="Transform Error Response" doc:id="892c7c66-f770-4d2c-a492-992385535c9a" >
					<ee:message >

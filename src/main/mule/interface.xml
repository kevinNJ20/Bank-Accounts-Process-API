		<apikit:console doc:name="APIkit Console" doc:id="60acec9c-6b01-43f8-9d8f-20808175527a" config-ref="bank-accounts-process-api-config" />
		<error-handler >
			<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="888ae8e7-faf8-4444-b05c-adcbfa28a713" type="APIKIT:NOT_FOUND" >

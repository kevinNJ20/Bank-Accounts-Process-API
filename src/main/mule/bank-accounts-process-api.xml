<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
  xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
  xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
  xmlns:anypoint-mq="http://www.mulesoft.org/schema/mule/anypoint-mq"
  xmlns:http="http://www.mulesoft.org/schema/mule/http"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
      http://www.mulesoft.org/schema/mule/anypoint-mq http://www.mulesoft.org/schema/mule/anypoint-mq/current/mule-anypoint-mq.xsd
      http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
      http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

  <!-- GET /accounts - Business Logic Flow -->
  <flow name="get-financial-summary-business-logic" doc:name="get-financial-summary-business-logic">
    <try doc:name="Try">
			<scatter-gather doc:name="Scatter-Gather" doc:id="b7d2bb7e-1628-451d-830b-7dd8dcca4034" >
				<route >
					<http:request doc:name="Get Accounts from Global Data" doc:id="209b1ec3-c79a-4794-9616-cb935f2a534b" config-ref="Global_Financial_Account_System_API_Config" path="/api/accounts">
						<http:query-params ><![CDATA[#[output application/java
---
{
	"customerGlobalId" :  vars.customerGlobalId
}]]]></http:query-params>
					</http:request>
				</route>
				<route >
					<http:request doc:name="Get Credit Cards" doc:id="b8fbb0a9-aed8-4f17-9bb4-b3facb92285a" config-ref="Credit_Card_System_API_Config" path="/api/cards">
						<http:query-params ><![CDATA[#[output application/java
---
{
	"customerId" :  vars.customerGlobalId
}]]]></http:query-params>
					</http:request>
				</route>
			</scatter-gather>
			<ee:transform doc:name="Aggregate Financial Summary">
        <ee:message>
          <ee:set-payload><![CDATA[%dw 2.0
output application/json
var accounts = payload[0] default []
var creditCards = payload[1] default []
---
{
  customer: {
    globalId: vars.customerGlobalId
  },
  accounts: accounts,
  creditCards: creditCards
}]]></ee:set-payload>
        </ee:message>
      </ee:transform>

      <set-variable value="200" doc:name="httpStatus" doc:id="d3d4a356-1b30-4ea3-bf48-82e66c597694" variableName="httpStatus"/>
      
      <error-handler>
        <on-error-propagate type="HTTP:CONNECTIVITY" enableNotifications="true" logException="true" doc:name="HTTP Error">
          <ee:transform doc:name="Transform Error">
            <ee:message>
              <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  error: {
    code: "SERVICE_ERROR",
    message: "An error occurred while fetching financial data",
    timestamp: now()
  }
}]]></ee:set-payload>
            </ee:message>
          </ee:transform>
          <set-variable value="500" doc:name="httpStatus" doc:id="d3d4a356-1b30-4ea3-bf48-82e66c597694" variableName="httpStatus"/>
        </on-error-propagate>
      </error-handler>
    </try>
  </flow>

  <!-- GET /accounts/{accountGlobalId} - Business Logic Flow -->
  <flow name="get-account-details-business-logic" doc:name="get-account-details-business-logic">
    <try doc:name="Try">
      <http:request config-ref="Global_Financial_Account_System_API_Config" path="/api/accounts/{accountGlobalId}" doc:name="Get Account from Global Data">
        <http:uri-params><![CDATA[#[{accountGlobalId: vars.accountGlobalId}]]]></http:uri-params>
      </http:request>

      <set-variable value="200" doc:name="httpStatus" doc:id="d3d4a356-1b30-4ea3-bf48-82e66c597694" variableName="httpStatus"/>
      
      <error-handler>
        <on-error-propagate type="HTTP:NOT_FOUND" enableNotifications="true" logException="true" doc:name="Not Found Error">
          <ee:transform doc:name="Transform Error">
            <ee:message>
              <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  error: {
    code: "NOT_FOUND",
    message: "Account not found",
    timestamp: now()
  }
}]]></ee:set-payload>
            </ee:message>
          </ee:transform>
          <set-variable value="404" doc:name="httpStatus" doc:id="d3d4a356-1b30-4ea3-bf48-82e66c597694" variableName="httpStatus"/>
        </on-error-propagate>
      </error-handler>
    </try>
  </flow>

  <!-- GET /accounts/{accountGlobalId}/transactions - Get Account Transactions -->
  <flow name="get-account-transactions-business-logic" doc:name="get-account-transactions-business-logic">
    <ee:transform doc:name="Build Query Parameters">
      <ee:message>
        <ee:set-payload><![CDATA[%dw 2.0
output application/java

var baseParams = {
  "accountGlobalId": vars.accountGlobalId,
  "limit": vars.limit default "100",
  "offset": vars.offset default "0"
}

var dateParams = {}
++ (if (vars.startDate != null and vars.startDate != "") {"startDate": vars.startDate as String} else {})
++ (if (vars.endDate != null and vars.endDate != "") {"endDate": vars.endDate as String} else {})
---
baseParams ++ dateParams]]></ee:set-payload>
      </ee:message>
    </ee:transform>
    <try doc:name="Try">
      <http:request config-ref="Global_Financial_Account_System_API_Config" path="/api/accounts/transactions" doc:name="Get Transactions">
        <http:query-params><![CDATA[#[payload]]]></http:query-params>
      </http:request>

      <set-variable value="200" doc:name="httpStatus" doc:id="d3d4a356-1b30-4ea3-bf48-82e66c597694" variableName="httpStatus"/>
      
      <error-handler>
        <on-error-propagate type="HTTP:CONNECTIVITY" enableNotifications="true" logException="true" doc:name="HTTP Error">
          <ee:transform doc:name="Transform Error">
            <ee:message>
              <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  error: {
    code: "SERVICE_ERROR",
    message: "An error occurred while fetching transactions",
    timestamp: now()
  }
}]]></ee:set-payload>
            </ee:message>
          </ee:transform>
          <set-variable value="500" doc:name="httpStatus" doc:id="d3d4a356-1b30-4ea3-bf48-82e66c597694" variableName="httpStatus"/>
        </on-error-propagate>
      </error-handler>
    </try>
  </flow>

  <!-- PUT /accounts/{accountGlobalId}/transactions/{transactionGlobalId} - Update Transaction (Dispute) -->
  <flow name="update-transaction-dispute-business-logic" doc:name="update-transaction-dispute-business-logic">
    <set-variable value="#[payload]" variableName="disputeRequest" doc:name="Save Dispute Request"/>
    
    <try doc:name="Try">
      <!-- First, get the existing transaction -->
      <http:request method="GET" config-ref="Global_Financial_Account_System_API_Config" path="/api/accounts/transactions" doc:name="Get Existing Transaction">
        <http:query-params><![CDATA[#[{
          accountGlobalId: vars.accountGlobalId
        }]]]></http:query-params>
      </http:request>

      <ee:transform doc:name="Find and Update Transaction">
        <ee:message>
          <ee:set-payload><![CDATA[%dw 2.0
output application/json
var transactions = payload default []
var existingTransaction = transactions[?($.globalId == vars.transactionGlobalId)][0] default null
var disputeRequest = vars.disputeRequest default {}
var disputeStatus = disputeRequest.disputeStatus default "PENDING"
var disputeReason = disputeRequest.disputeReason default ""
---
if (existingTransaction != null)
  existingTransaction update {
    case .status -> "Disputed"
    case .disputeStatus -> disputeStatus
    case .disputeReason -> disputeReason
  }
else {
  // If transaction not found, create minimal transaction for dispute
  globalId: vars.transactionGlobalId,
  transactionNumber: "DISPUTE-" ++ vars.transactionGlobalId,
  accountGlobalId: vars.accountGlobalId,
  transactionType: "Dispute",
  amount: 0.00,
  currency: "USD",
  transactionDate: now(),
  description: "Transaction dispute",
  status: "Disputed",
  disputeStatus: disputeStatus,
  disputeReason: disputeReason
}]]></ee:set-payload>
        </ee:message>
      </ee:transform>

      <http:request method="POST" config-ref="Global_Financial_Account_System_API_Config" path="/api/accounts/transactions" doc:name="Update Transaction">
      </http:request>

      <set-variable value="200" doc:name="httpStatus" doc:id="d3d4a356-1b30-4ea3-bf48-82e66c597694" variableName="httpStatus"/>
      
      <error-handler>
        <on-error-propagate type="HTTP:CONNECTIVITY" enableNotifications="true" logException="true" doc:name="HTTP Error">
          <ee:transform doc:name="Transform Error">
            <ee:message>
              <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  error: {
    code: "SERVICE_ERROR",
    message: "An error occurred while updating transaction",
    timestamp: now()
  }
}]]></ee:set-payload>
            </ee:message>
          </ee:transform>
          <set-variable value="500" doc:name="httpStatus" doc:id="d3d4a356-1b30-4ea3-bf48-82e66c597694" variableName="httpStatus"/>
        </on-error-propagate>
      </error-handler>
    </try>
  </flow>

  <!-- GET /cards - Get Credit Cards -->
  <flow name="get-credit-cards-business-logic" doc:name="get-credit-cards-business-logic">
    <try doc:name="Try">
      <http:request config-ref="Credit_Card_System_API_Config" path="/api/cards" doc:name="Get Credit Cards">
        <http:query-params><![CDATA[#[{
          "customerId": vars.customerGlobalId
        }]]]></http:query-params>
      </http:request>

      <set-variable value="200" doc:name="httpStatus" doc:id="d3d4a356-1b30-4ea3-bf48-82e66c597694" variableName="httpStatus"/>
      
      <error-handler>
        <on-error-propagate type="HTTP:CONNECTIVITY" enableNotifications="true" logException="true" doc:name="HTTP Error">
          <ee:transform doc:name="Transform Error">
            <ee:message>
              <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  error: {
    code: "SERVICE_ERROR",
    message: "An error occurred while fetching credit cards",
    timestamp: now()
  }
}]]></ee:set-payload>
            </ee:message>
          </ee:transform>
          <set-variable value="500" doc:name="httpStatus" doc:id="d3d4a356-1b30-4ea3-bf48-82e66c597694" variableName="httpStatus"/>
        </on-error-propagate>
      </error-handler>
    </try>
  </flow>

  <!-- PUT /cards/{cardGlobalId} - Update Card Controls -->
  <flow name="update-card-controls-business-logic" doc:name="update-card-controls-business-logic">
    <set-variable value="#[payload]" variableName="cardControlsRequest" doc:name="Save Card Controls Request"/>
    
    <try doc:name="Try">
      <!-- First, get the existing card - use cardGlobalId as cardId for credit-card-system-api -->
      <http:request method="GET" config-ref="Credit_Card_System_API_Config" path="/api/cards/{cardId}" doc:name="Get Existing Card">
        <http:uri-params><![CDATA[#[output application/java
---
{
  "cardId": vars.cardGlobalId
}]]]></http:uri-params>
      </http:request>

      <ee:transform doc:name="Merge Card Controls">
        <ee:message>
          <ee:set-payload><![CDATA[%dw 2.0
output application/json
var existingCard = payload default {}
var controlsRequest = vars.cardControlsRequest default {}
var existingControls = existingCard.controls default {}
var newControls = if (controlsRequest.controls != null) {
  dailyPurchaseLimit: controlsRequest.controls.dailyPurchaseLimit default existingControls.dailyPurchaseLimit default null,
  dailyATMWithdrawalLimit: controlsRequest.controls.dailyATMWithdrawalLimit default existingControls.dailyATMWithdrawalLimit default null,
  internationalTransactionsEnabled: controlsRequest.controls.internationalTransactionsEnabled default existingControls.internationalTransactionsEnabled default null,
  onlineTransactionsEnabled: controlsRequest.controls.onlineTransactionsEnabled default existingControls.onlineTransactionsEnabled default null
} else existingControls
var mergedCard = existingCard update {
  case .status -> controlsRequest.status default existingCard.status
  case .creditLimit -> controlsRequest.creditLimit default existingCard.creditLimit
  case .availableCredit -> controlsRequest.availableCredit default existingCard.availableCredit
  case .controls -> newControls
}
---
// Filtrer les champs null pour éviter les erreurs de validation RAML
mergedCard filterObject ((value, key) -> value != null)]]></ee:set-payload>
        </ee:message>
      </ee:transform>

      <http:request method="PUT" config-ref="Credit_Card_System_API_Config" path="/api/cards/{cardId}" doc:name="Update Card">
				<http:uri-params ><![CDATA[#[output application/java
---
{
	"cardId" : vars.cardGlobalId
}]]]></http:uri-params>
      </http:request>

      <set-variable value="200" doc:name="httpStatus" doc:id="d3d4a356-1b30-4ea3-bf48-82e66c597694" variableName="httpStatus"/>
      
      <error-handler>
        <on-error-propagate type="HTTP:CONNECTIVITY" enableNotifications="true" logException="true" doc:name="HTTP Error">
          <ee:transform doc:name="Transform Error">
            <ee:message>
              <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  error: {
    code: "SERVICE_ERROR",
    message: "An error occurred while updating card controls",
    timestamp: now()
  }
}]]></ee:set-payload>
            </ee:message>
          </ee:transform>
          <set-variable value="500" doc:name="httpStatus" doc:id="d3d4a356-1b30-4ea3-bf48-82e66c597694" variableName="httpStatus"/>
        </on-error-propagate>
      </error-handler>
    </try>
  </flow>

  <!-- POST /sync - Trigger Sync -->
  <flow name="trigger-sync-business-logic" doc:name="trigger-sync-business-logic">
    <ee:transform doc:name="Transform Response">
      <ee:message>
        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  message: "Sync request accepted",
  syncId: uuid()
}]]></ee:set-payload>
      </ee:message>
    </ee:transform>

    <set-variable value="202" doc:name="httpStatus" doc:id="d3d4a356-1b30-4ea3-bf48-82e66c597694" variableName="httpStatus"/>
  </flow>

  <!-- MQ Listener: Consume Account Updates from Accounts Queue -->
  <flow name="consume-account-update-from-mq" doc:name="consume-account-update-from-mq">
    
    <anypoint-mq:consume doc:name="Consume from Accounts Queue" doc:id="ead79a6a-c3af-40a8-b1ae-8484b1d1f1e8" config-ref="Anypoint_MQ_Config" destination="Accounts-Queue"/>
		<logger level="INFO" message="Received account update from MQ: #[payload]" doc:name="Log Account Update"/>
    
    <try doc:name="Try">
      <ee:transform doc:name="Transform MQ Message to Account Format">
        <ee:message>
          <ee:set-payload><![CDATA[%dw 2.0
output application/json
var msg = payload
---
{
  globalId: null,
  accountNumber: msg.accountNumber,
  accountType: msg.accountType,
  accountName: msg.accountName,
  balance: msg.balance default 0.00,
  status: msg.status default "Active",
  externalIds: [{
    system: "Salesforce",
    value: msg.accountId
  }]
}]]></ee:set-payload>
        </ee:message>
      </ee:transform>

      <http:request method="POST" config-ref="Global_Financial_Account_System_API_Config" path="/api/accounts" doc:name="Upsert Account to Global Data">
      </http:request>

      <http:request method="POST" config-ref="Salesforce_Financial_System_API_Config" path="/api/accounts" doc:name="Upsert Account to Salesforce">
      </http:request>

      <logger level="INFO" message="Successfully processed account update from MQ" doc:name="Log Success"/>

      <error-handler>
        <on-error-continue type="ANYPOINT-MQ:CONNECTIVITY,HTTP:CONNECTIVITY" enableNotifications="true" logException="true" doc:name="Continue on Error">
          <logger level="ERROR" message="Error processing account update from MQ: #[error.description]" doc:name="Log Error"/>
        </on-error-continue>
      </error-handler>
    </try>
  </flow>

  <!-- MQ Listener: Consume Transaction Updates from Transactions Queue -->
  <flow name="consume-transaction-update-from-mq" doc:name="consume-transaction-update-from-mq">
    
    <anypoint-mq:consume doc:name="Consume from Transactions Queue" doc:id="c112c25d-626d-4a0d-97e8-d29f2d4de4b8" config-ref="Anypoint_MQ_Config" destination="Transactions-Queue" />
		<logger level="INFO" message="Received transaction update from MQ: #[payload]" doc:name="Log Transaction Update"/>
    
    <try doc:name="Try">
      <ee:transform doc:name="Transform MQ Message to Transaction Format">
        <ee:message>
          <ee:set-payload><![CDATA[%dw 2.0
output application/json
var msg = payload
---
{
  globalId: null,
  transactionNumber: msg.transactionNumber,
  transactionType: msg.transactionType,
  amount: msg.amount default 0.00,
  currency: msg.currency default "USD",
  description: msg.description,
  status: msg.status default "Posted",
  transactionDate: msg.transactionDate default now(),
  externalIds: [{
    system: "Salesforce",
    value: msg.transactionId
  }]
}]]></ee:set-payload>
        </ee:message>
      </ee:transform>

      <http:request method="POST" config-ref="Global_Financial_Account_System_API_Config" path="/api/accounts/transactions" doc:name="Upsert Transaction to Global Data">
      </http:request>

      <http:request method="POST" config-ref="Salesforce_Financial_System_API_Config" path="/api/transactions" doc:name="Upsert Transaction to Salesforce">
      </http:request>

      <logger level="INFO" message="Successfully processed transaction update from MQ" doc:name="Log Success"/>

      <error-handler>
        <on-error-continue type="ANYPOINT-MQ:CONNECTIVITY,HTTP:CONNECTIVITY" enableNotifications="true" logException="true" doc:name="Continue on Error">
          <logger level="ERROR" message="Error processing transaction update from MQ: #[error.description]" doc:name="Log Error"/>
        </on-error-continue>
      </error-handler>
    </try>
  
</flow>

  <!-- MQ Listener: Consume Card Updates from Cards Queue -->
  <flow name="consume-card-update-from-mq" doc:name="consume-card-update-from-mq">
    
    <anypoint-mq:consume doc:name="Consume from Cards Queue" doc:id="4ec6145a-eb71-4133-a622-ffc8b1111bd7" config-ref="Anypoint_MQ_Config" destination="Cards-Queue" />
		<logger level="INFO" message="Received card update from MQ: #[payload]" doc:name="Log Card Update"/>
    
    <try doc:name="Try">
      <ee:transform doc:name="Transform MQ Message to Card Format">
        <ee:message>
          <ee:set-payload><![CDATA[%dw 2.0
output application/json
var msg = payload
---
{
  globalId: null,
  cardNumber: msg.cardNumber,
  cardType: msg.cardType,
  cardNetwork: msg.cardNetwork,
  status: msg.status default "Active",
  creditLimit: msg.creditLimit default 0.00,
  externalIds: [{
    system: "Salesforce",
    value: msg.cardId
  }]
}]]></ee:set-payload>
        </ee:message>
      </ee:transform>

      <http:request method="POST" config-ref="Global_Financial_Account_System_API_Config" path="/api/accounts/cards" doc:name="Upsert Card to Global Data">
      </http:request>

      <http:request method="POST" config-ref="Salesforce_Financial_System_API_Config" path="/api/cards" doc:name="Upsert Card to Salesforce">
      </http:request>

      <ee:transform doc:name="Extract Card ID for Credit Card System">
        <ee:variables>
          <ee:set-variable variableName="cardId"><![CDATA[#[payload.externalIds[0].value default payload.cardNumber]]]></ee:set-variable>
        </ee:variables>
      </ee:transform>
      <http:request method="PUT" config-ref="Credit_Card_System_API_Config" path="/api/cards/{cardId}" doc:name="Update Card in Credit Card System">
        <http:uri-params><![CDATA[#[output application/java
---
{cardId: vars.cardId}]]]></http:uri-params>
      </http:request>

      <logger level="INFO" message="Successfully processed card update from MQ" doc:name="Log Success"/>

      <error-handler>
        <on-error-continue type="ANYPOINT-MQ:CONNECTIVITY,HTTP:CONNECTIVITY" enableNotifications="true" logException="true" doc:name="Continue on Error">
          <logger level="ERROR" message="Error processing card update from MQ: #[error.description]" doc:name="Log Error"/>
        </on-error-continue>
      </error-handler>
    </try>
  
</flow>

</mule>

<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
  xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
  xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
  xmlns:anypoint-mq="http://www.mulesoft.org/schema/mule/anypoint-mq"
  xmlns:http="http://www.mulesoft.org/schema/mule/http"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
      http://www.mulesoft.org/schema/mule/anypoint-mq http://www.mulesoft.org/schema/mule/anypoint-mq/current/mule-anypoint-mq.xsd
      http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
      http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

  <!-- GET /accounts - Business Logic Flow -->
  <flow name="get-financial-summary-business-logic" doc:name="get-financial-summary-business-logic">
    <try doc:name="Try">
			<scatter-gather doc:name="Scatter-Gather" doc:id="b7d2bb7e-1628-451d-830b-7dd8dcca4034" >
				<route >
					<http:request doc:name="Get Accounts from Global Data" doc:id="209b1ec3-c79a-4794-9616-cb935f2a534b" config-ref="Global_Financial_Account_System_API_Config" path="/api/global/accounts">
						<http:query-params ><![CDATA[#[output application/java
---
{
	"customerGlobalId" :  vars.customerGlobalId
}]]]></http:query-params>
					</http:request>
				</route>
				<route >
					<http:request doc:name="Get Credit Cards" doc:id="b8fbb0a9-aed8-4f17-9bb4-b3facb92285a" config-ref="Credit_Card_System_API_Config" path="/api/creditcards/cards">
						<http:query-params ><![CDATA[#[output application/java
---
{
	"customerId" :  vars.customerGlobalId
}]]]></http:query-params>
					</http:request>
				</route>
			</scatter-gather>
			<ee:transform doc:name="Aggregate Financial Summary">
        <ee:message>
          <ee:set-payload><![CDATA[%dw 2.0
output application/json
var accounts = payload[0] default []
var creditCards = payload[1] default []
---
{
  customer: {
    globalId: vars.customerGlobalId
  },
  accounts: accounts,
  creditCards: creditCards
}]]></ee:set-payload>
        </ee:message>
      </ee:transform>

      <set-variable value="200" doc:name="httpStatus" doc:id="d3d4a356-1b30-4ea3-bf48-82e66c597694" variableName="httpStatus"/>
      
      <error-handler>
        <on-error-propagate type="HTTP:REQUEST" enableNotifications="true" logException="true" doc:name="HTTP Error">
          <ee:transform doc:name="Transform Error">
            <ee:message>
              <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  error: {
    code: "SERVICE_ERROR",
    message: "An error occurred while fetching financial data",
    timestamp: now()
  }
}]]></ee:set-payload>
            </ee:message>
          </ee:transform>
          <set-variable value="500" doc:name="httpStatus" doc:id="d3d4a356-1b30-4ea3-bf48-82e66c597694" variableName="httpStatus"/>
        </on-error-propagate>
      </error-handler>
    </try>
  </flow>

  <!-- GET /accounts/{accountGlobalId} - Business Logic Flow -->
  <flow name="get-account-details-business-logic" doc:name="get-account-details-business-logic">
    <try doc:name="Try">
      <http:request method="GET" config-ref="Global_Financial_Account_System_API_Config" path="/api/global/accounts/{accountGlobalId}" doc:name="Get Account from Global Data">
        <http:uri-params><![CDATA[#[{accountGlobalId: vars.accountGlobalId}]]]></http:uri-params>
      </http:request>

      <set-variable value="200" doc:name="httpStatus" doc:id="d3d4a356-1b30-4ea3-bf48-82e66c597694" variableName="httpStatus"/>
      
      <error-handler>
        <on-error-propagate type="HTTP:NOT_FOUND" enableNotifications="true" logException="true" doc:name="Not Found Error">
          <ee:transform doc:name="Transform Error">
            <ee:message>
              <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  error: {
    code: "NOT_FOUND",
    message: "Account not found",
    timestamp: now()
  }
}]]></ee:set-payload>
            </ee:message>
          </ee:transform>
          <set-variable value="404" doc:name="httpStatus" doc:id="d3d4a356-1b30-4ea3-bf48-82e66c597694" variableName="httpStatus"/>
        </on-error-propagate>
      </error-handler>
    </try>
  </flow>

  <!-- GET /accounts/{accountGlobalId}/transactions - Get Account Transactions -->
  <flow name="get-account-transactions-flow" doc:name="get-account-transactions-flow">
    <http:listener doc:name="GET /accounts/{accountGlobalId}/transactions" config-ref="HTTP_Listener_config" path="/api/bank-accounts/accounts/{accountGlobalId}/transactions" allowedMethods="GET"/>
    
    <try doc:name="Try">
      <http:request method="GET" config-ref="Global_Financial_Account_System_API_Config" path="/api/global/accounts/transactions" doc:name="Get Transactions">
        <http:query-params><![CDATA[#[{
          "accountGlobalId": attributes.uriParams.accountGlobalId,
          "startDate": attributes.queryParams.startDate default null,
          "endDate": attributes.queryParams.endDate default null,
          "limit": attributes.queryParams.limit default "100",
          "offset": attributes.queryParams.offset default "0"
        }]]]></http:query-params>
      </http:request>

      <set-variable value="200" doc:name="httpStatus" doc:id="d3d4a356-1b30-4ea3-bf48-82e66c597694" variableName="httpStatus"/>
      
      <error-handler>
        <on-error-propagate type="HTTP:REQUEST" enableNotifications="true" logException="true" doc:name="HTTP Error">
          <ee:transform doc:name="Transform Error">
            <ee:message>
              <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  error: {
    code: "SERVICE_ERROR",
    message: "An error occurred while fetching transactions",
    timestamp: now()
  }
}]]></ee:set-payload>
            </ee:message>
          </ee:transform>
          <set-variable value="500" doc:name="httpStatus" doc:id="d3d4a356-1b30-4ea3-bf48-82e66c597694" variableName="httpStatus"/>
        </on-error-propagate>
      </error-handler>
    </try>
  </flow>

  <!-- PUT /accounts/{accountGlobalId}/transactions/{transactionGlobalId} - Update Transaction (Dispute) -->
  <flow name="update-transaction-dispute-flow" doc:name="update-transaction-dispute-flow">
    <http:listener doc:name="PUT /accounts/{accountGlobalId}/transactions/{transactionGlobalId}" config-ref="HTTP_Listener_config" path="/api/bank-accounts/accounts/{accountGlobalId}/transactions/{transactionGlobalId}" allowedMethods="PUT"/>
    
    <ee:transform doc:name="Transform Request">
      <ee:message>
        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  globalId: attributes.uriParams.transactionGlobalId,
  disputeStatus: payload.disputeStatus,
  disputeReason: payload.disputeReason,
  status: "Disputed"
}]]></ee:set-payload>
      </ee:message>
    </ee:transform>

    <try doc:name="Try">
      <http:request method="POST" config-ref="Global_Financial_Account_System_API_Config" path="/api/global/accounts/transactions" doc:name="Update Transaction">
        <http:body><![CDATA[#[payload]]]></http:body>
      </http:request>

      <set-variable value="200" doc:name="httpStatus" doc:id="d3d4a356-1b30-4ea3-bf48-82e66c597694" variableName="httpStatus"/>
      
      <error-handler>
        <on-error-propagate type="HTTP:REQUEST" enableNotifications="true" logException="true" doc:name="HTTP Error">
          <ee:transform doc:name="Transform Error">
            <ee:message>
              <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  error: {
    code: "SERVICE_ERROR",
    message: "An error occurred while updating transaction",
    timestamp: now()
  }
}]]></ee:set-payload>
            </ee:message>
          </ee:transform>
          <set-variable value="500" doc:name="httpStatus" doc:id="d3d4a356-1b30-4ea3-bf48-82e66c597694" variableName="httpStatus"/>
        </on-error-propagate>
      </error-handler>
    </try>
  </flow>

  <!-- GET /cards - Get Credit Cards -->
  <flow name="get-credit-cards-flow" doc:name="get-credit-cards-flow">
    <http:listener doc:name="GET /cards" config-ref="HTTP_Listener_config" path="/api/bank-accounts/cards" allowedMethods="GET"/>
    
    <try doc:name="Try">
      <http:request method="GET" config-ref="Credit_Card_System_API_Config" path="/api/creditcards/cards" doc:name="Get Credit Cards">
        <http:query-params><![CDATA[#[{
          "customerId": attributes.queryParams.customerGlobalId
        }]]]></http:query-params>
      </http:request>

      <set-variable value="200" doc:name="httpStatus" doc:id="d3d4a356-1b30-4ea3-bf48-82e66c597694" variableName="httpStatus"/>
      
      <error-handler>
        <on-error-propagate type="HTTP:REQUEST" enableNotifications="true" logException="true" doc:name="HTTP Error">
          <ee:transform doc:name="Transform Error">
            <ee:message>
              <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  error: {
    code: "SERVICE_ERROR",
    message: "An error occurred while fetching credit cards",
    timestamp: now()
  }
}]]></ee:set-payload>
            </ee:message>
          </ee:transform>
          <set-variable value="500" doc:name="httpStatus" doc:id="d3d4a356-1b30-4ea3-bf48-82e66c597694" variableName="httpStatus"/>
        </on-error-propagate>
      </error-handler>
    </try>
  </flow>

  <!-- PUT /cards/{cardGlobalId} - Update Card Controls -->
  <flow name="update-card-controls-flow" doc:name="update-card-controls-flow">
    <http:listener doc:name="PUT /cards/{cardGlobalId}" config-ref="HTTP_Listener_config" path="/api/bank-accounts/cards/{cardGlobalId}" allowedMethods="PUT"/>
    
    <try doc:name="Try">
      <http:request method="PUT" config-ref="Credit_Card_System_API_Config" path="/api/creditcards/cards/{cardGlobalId}" doc:name="Update Card">
				<http:uri-params ><![CDATA[#[output application/java
---
{
	"cardGlobalId" : attributes.uriParams.cardGlobalId
}]]]></http:uri-params>

      </http:request>

      <set-variable value="200" doc:name="httpStatus" doc:id="d3d4a356-1b30-4ea3-bf48-82e66c597694" variableName="httpStatus"/>
      
      <error-handler>
        <on-error-propagate type="HTTP:REQUEST" enableNotifications="true" logException="true" doc:name="HTTP Error">
          <ee:transform doc:name="Transform Error">
            <ee:message>
              <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  error: {
    code: "SERVICE_ERROR",
    message: "An error occurred while updating card controls",
    timestamp: now()
  }
}]]></ee:set-payload>
            </ee:message>
          </ee:transform>
          <set-variable value="500" doc:name="httpStatus" doc:id="d3d4a356-1b30-4ea3-bf48-82e66c597694" variableName="httpStatus"/>
        </on-error-propagate>
      </error-handler>
    </try>
  </flow>

  <!-- POST /sync - Trigger Sync -->
  <flow name="trigger-sync-flow" doc:name="trigger-sync-flow">
    <http:listener doc:name="POST /sync" config-ref="HTTP_Listener_config" path="/api/bank-accounts/sync" allowedMethods="POST"/>
    
    <ee:transform doc:name="Transform Response">
      <ee:message>
        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  message: "Sync request accepted",
  syncId: uuid()
}]]></ee:set-payload>
      </ee:message>
    </ee:transform>

    <set-variable value="202" doc:name="httpStatus" doc:id="d3d4a356-1b30-4ea3-bf48-82e66c597694" variableName="httpStatus"/>
  </flow>

  <!-- MQ Listener: Consume Account Updates from Accounts Queue -->
  <flow name="consume-account-update-from-mq" doc:name="consume-account-update-from-mq">
    <anypoint-mq:consume doc:name="Consume from Accounts Queue" config-ref="Anypoint_MQ_Config" destination="Accounts-Queue">
      <anypoint-mq:maximum-messages>1</anypoint-mq:maximum-messages>
    </anypoint-mq:consume>
    
    <logger level="INFO" message="Received account update from MQ: #[payload]" doc:name="Log Account Update"/>
    
    <try doc:name="Try">
      <ee:transform doc:name="Transform MQ Message to Account Format">
        <ee:message>
          <ee:set-payload><![CDATA[%dw 2.0
output application/json
var msg = payload
---
{
  globalId: null,
  accountNumber: msg.accountNumber,
  accountType: msg.accountType,
  accountName: msg.accountName,
  balance: msg.balance default 0.00,
  status: msg.status default "Active",
  externalIds: [{
    system: "Salesforce",
    value: msg.accountId
  }]
}]]></ee:set-payload>
        </ee:message>
      </ee:transform>

      <http:request method="POST" config-ref="Global_Financial_Account_System_API_Config" path="/api/global/accounts" doc:name="Upsert Account to Global Data">
        <http:body><![CDATA[#[payload]]]></http:body>
      </http:request>

      <http:request method="POST" config-ref="Salesforce_Financial_System_API_Config" path="/api/salesforce/financial/accounts" doc:name="Upsert Account to Salesforce">
        <http:body><![CDATA[#[payload]]]></http:body>
      </http:request>

      <logger level="INFO" message="Successfully processed account update from MQ" doc:name="Log Success"/>

      <error-handler>
        <on-error-continue type="ANYPOINT-MQ:CONSUME,HTTP:REQUEST" enableNotifications="true" logException="true" doc:name="Continue on Error">
          <logger level="ERROR" message="Error processing account update from MQ: #[error.description]" doc:name="Log Error"/>
        </on-error-continue>
      </error-handler>
    </try>
  </flow>

  <!-- MQ Listener: Consume Transaction Updates from Transactions Queue -->
  <flow name="consume-transaction-update-from-mq" doc:name="consume-transaction-update-from-mq">
    <anypoint-mq:consume doc:name="Consume from Transactions Queue" config-ref="Anypoint_MQ_Config" destination="Transactions-Queue">
      <anypoint-mq:maximum-messages>1</anypoint-mq:maximum-messages>
    </anypoint-mq:consume>
    
    <logger level="INFO" message="Received transaction update from MQ: #[payload]" doc:name="Log Transaction Update"/>
    
    <try doc:name="Try">
      <ee:transform doc:name="Transform MQ Message to Transaction Format">
        <ee:message>
          <ee:set-payload><![CDATA[%dw 2.0
output application/json
var msg = payload
---
{
  globalId: null,
  transactionNumber: msg.transactionNumber,
  transactionType: msg.transactionType,
  amount: msg.amount default 0.00,
  currency: msg.currency default "USD",
  description: msg.description,
  status: msg.status default "Posted",
  transactionDate: msg.transactionDate default now(),
  externalIds: [{
    system: "Salesforce",
    value: msg.transactionId
  }]
}]]></ee:set-payload>
        </ee:message>
      </ee:transform>

      <http:request method="POST" config-ref="Global_Financial_Account_System_API_Config" path="/api/global/accounts/transactions" doc:name="Upsert Transaction to Global Data">
        <http:body><![CDATA[#[payload]]]></http:body>
      </http:request>

      <http:request method="POST" config-ref="Salesforce_Financial_System_API_Config" path="/api/salesforce/financial/transactions" doc:name="Upsert Transaction to Salesforce">
        <http:body><![CDATA[#[payload]]]></http:body>
      </http:request>

      <logger level="INFO" message="Successfully processed transaction update from MQ" doc:name="Log Success"/>

      <error-handler>
        <on-error-continue type="ANYPOINT-MQ:CONSUME,HTTP:REQUEST" enableNotifications="true" logException="true" doc:name="Continue on Error">
          <logger level="ERROR" message="Error processing transaction update from MQ: #[error.description]" doc:name="Log Error"/>
        </on-error-continue>
      </error-handler>
    </try>
  </flow>

  <!-- MQ Listener: Consume Card Updates from Cards Queue -->
  <flow name="consume-card-update-from-mq" doc:name="consume-card-update-from-mq">
    <anypoint-mq:consume doc:name="Consume from Cards Queue" config-ref="Anypoint_MQ_Config" destination="Cards-Queue">
      <anypoint-mq:maximum-messages>1</anypoint-mq:maximum-messages>
    </anypoint-mq:consume>
    
    <logger level="INFO" message="Received card update from MQ: #[payload]" doc:name="Log Card Update"/>
    
    <try doc:name="Try">
      <ee:transform doc:name="Transform MQ Message to Card Format">
        <ee:message>
          <ee:set-payload><![CDATA[%dw 2.0
output application/json
var msg = payload
---
{
  globalId: null,
  cardNumber: msg.cardNumber,
  cardType: msg.cardType,
  cardNetwork: msg.cardNetwork,
  status: msg.status default "Active",
  creditLimit: msg.creditLimit default 0.00,
  externalIds: [{
    system: "Salesforce",
    value: msg.cardId
  }]
}]]></ee:set-payload>
        </ee:message>
      </ee:transform>

      <http:request method="POST" config-ref="Global_Financial_Account_System_API_Config" path="/api/global/accounts/cards" doc:name="Upsert Card to Global Data">
        <http:body><![CDATA[#[payload]]]></http:body>
      </http:request>

      <http:request method="POST" config-ref="Salesforce_Financial_System_API_Config" path="/api/salesforce/financial/cards" doc:name="Upsert Card to Salesforce">
        <http:body><![CDATA[#[payload]]]></http:body>
      </http:request>

      <ee:transform doc:name="Extract Card ID for Credit Card System">
        <ee:variables>
          <ee:set-variable variableName="cardId"><![CDATA[#[payload.externalIds[0].value default payload.cardNumber]]]></ee:set-variable>
        </ee:variables>
      </ee:transform>
      <http:request method="PUT" config-ref="Credit_Card_System_API_Config" path="/api/creditcards/cards/{cardId}" doc:name="Update Card in Credit Card System">
        <http:uri-params><![CDATA[#[output application/java
---
{cardId: vars.cardId}]]]></http:uri-params>
      </http:request>

      <logger level="INFO" message="Successfully processed card update from MQ" doc:name="Log Success"/>

      <error-handler>
        <on-error-continue type="ANYPOINT-MQ:CONSUME,HTTP:REQUEST" enableNotifications="true" logException="true" doc:name="Continue on Error">
          <logger level="ERROR" message="Error processing card update from MQ: #[error.description]" doc:name="Log Error"/>
        </on-error-continue>
      </error-handler>
    </try>
  </flow>

</mule>

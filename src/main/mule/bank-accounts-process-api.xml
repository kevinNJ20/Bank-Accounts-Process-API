<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
  xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
  xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
      http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

  <!-- GET /accounts - Business Logic Flow -->
  <flow name="get-financial-summary-business-logic" doc:name="get-financial-summary-business-logic">
    <try doc:name="Try">
      <parallel doc:name="Parallel">
        <http:request method="GET" config-ref="Global_Financial_Account_System_API_Config" path="/api/global/accounts" doc:name="Get Accounts from Global Data">
          <http:query-params><![CDATA[#[{
            "customerGlobalId": vars.customerGlobalId
          }]]]></http:query-params>
        </http:request>
        
        <http:request method="GET" config-ref="Credit_Card_System_API_Config" path="/api/creditcards/cards" doc:name="Get Credit Cards">
          <http:query-params><![CDATA[#[{
            "customerId": vars.customerGlobalId
          }]]]></http:query-params>
        </http:request>
      </parallel>

      <ee:transform doc:name="Aggregate Financial Summary">
        <ee:message>
          <ee:set-payload><![CDATA[%dw 2.0
output application/json
var accounts = payload[0] default []
var creditCards = payload[1] default []
---
{
  customer: {
    globalId: vars.customerGlobalId
  },
  accounts: accounts,
  creditCards: creditCards
}]]></ee:set-payload>
        </ee:message>
      </ee:transform>

      <http:response statusCode="200" doc:name="HTTP Response"/>
      
      <error-handler>
        <on-error-propagate type="HTTP:REQUEST" enableNotifications="true" logException="true" doc:name="HTTP Error">
          <ee:transform doc:name="Transform Error">
            <ee:message>
              <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  error: {
    code: "SERVICE_ERROR",
    message: "An error occurred while fetching financial data",
    timestamp: now()
  }
}]]></ee:set-payload>
            </ee:message>
          </ee:transform>
          <http:response statusCode="500" doc:name="HTTP Response"/>
        </on-error-propagate>
      </error-handler>
    </try>
  </flow>

  <!-- GET /accounts/{accountGlobalId} - Business Logic Flow -->
  <flow name="get-account-details-business-logic" doc:name="get-account-details-business-logic">
    <try doc:name="Try">
      <http:request method="GET" config-ref="Global_Financial_Account_System_API_Config" path="/api/global/accounts/{accountGlobalId}" doc:name="Get Account from Global Data">
        <http:uri-params><![CDATA[#[{accountGlobalId: vars.accountGlobalId}]]]></http:uri-params>
      </http:request>

      <http:response statusCode="200" doc:name="HTTP Response"/>
      
      <error-handler>
        <on-error-propagate type="HTTP:NOT_FOUND" enableNotifications="true" logException="true" doc:name="Not Found Error">
          <ee:transform doc:name="Transform Error">
            <ee:message>
              <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  error: {
    code: "NOT_FOUND",
    message: "Account not found",
    timestamp: now()
  }
}]]></ee:set-payload>
            </ee:message>
          </ee:transform>
          <http:response statusCode="404" doc:name="HTTP Response"/>
        </on-error-propagate>
      </error-handler>
    </try>
  </flow>

  <!-- GET /accounts/{accountGlobalId}/transactions - Get Account Transactions -->
  <flow name="get-account-transactions-flow" doc:name="get-account-transactions-flow">
    <http:listener doc:name="GET /accounts/{accountGlobalId}/transactions" config-ref="HTTP_Listener_config" path="/api/bank-accounts/accounts/{accountGlobalId}/transactions" allowedMethods="GET"/>
    
    <try doc:name="Try">
      <http:request method="GET" config-ref="Global_Financial_Account_System_API_Config" path="/api/global/accounts/transactions" doc:name="Get Transactions">
        <http:query-params><![CDATA[#[{
          "accountGlobalId": attributes.uriParams.accountGlobalId,
          "startDate": attributes.queryParams.startDate default null,
          "endDate": attributes.queryParams.endDate default null,
          "limit": attributes.queryParams.limit default "100",
          "offset": attributes.queryParams.offset default "0"
        }]]]></http:query-params>
      </http:request>

      <http:response statusCode="200" doc:name="HTTP Response"/>
      
      <error-handler>
        <on-error-propagate type="HTTP:REQUEST" enableNotifications="true" logException="true" doc:name="HTTP Error">
          <ee:transform doc:name="Transform Error">
            <ee:message>
              <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  error: {
    code: "SERVICE_ERROR",
    message: "An error occurred while fetching transactions",
    timestamp: now()
  }
}]]></ee:set-payload>
            </ee:message>
          </ee:transform>
          <http:response statusCode="500" doc:name="HTTP Response"/>
        </on-error-propagate>
      </error-handler>
    </try>
  </flow>

  <!-- PUT /accounts/{accountGlobalId}/transactions/{transactionGlobalId} - Update Transaction (Dispute) -->
  <flow name="update-transaction-dispute-flow" doc:name="update-transaction-dispute-flow">
    <http:listener doc:name="PUT /accounts/{accountGlobalId}/transactions/{transactionGlobalId}" config-ref="HTTP_Listener_config" path="/api/bank-accounts/accounts/{accountGlobalId}/transactions/{transactionGlobalId}" allowedMethods="PUT"/>
    
    <ee:transform doc:name="Transform Request">
      <ee:message>
        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  globalId: attributes.uriParams.transactionGlobalId,
  disputeStatus: payload.disputeStatus,
  disputeReason: payload.disputeReason,
  status: "Disputed"
}]]></ee:set-payload>
      </ee:message>
    </ee:transform>

    <try doc:name="Try">
      <http:request method="POST" config-ref="Global_Financial_Account_System_API_Config" path="/api/global/accounts/transactions" doc:name="Update Transaction">
        <http:body><![CDATA[#[payload]]]></http:body>
      </http:request>

      <http:response statusCode="200" doc:name="HTTP Response"/>
      
      <error-handler>
        <on-error-propagate type="HTTP:REQUEST" enableNotifications="true" logException="true" doc:name="HTTP Error">
          <ee:transform doc:name="Transform Error">
            <ee:message>
              <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  error: {
    code: "SERVICE_ERROR",
    message: "An error occurred while updating transaction",
    timestamp: now()
  }
}]]></ee:set-payload>
            </ee:message>
          </ee:transform>
          <http:response statusCode="500" doc:name="HTTP Response"/>
        </on-error-propagate>
      </error-handler>
    </try>
  </flow>

  <!-- GET /cards - Get Credit Cards -->
  <flow name="get-credit-cards-flow" doc:name="get-credit-cards-flow">
    <http:listener doc:name="GET /cards" config-ref="HTTP_Listener_config" path="/api/bank-accounts/cards" allowedMethods="GET"/>
    
    <try doc:name="Try">
      <http:request method="GET" config-ref="Credit_Card_System_API_Config" path="/api/creditcards/cards" doc:name="Get Credit Cards">
        <http:query-params><![CDATA[#[{
          "customerId": attributes.queryParams.customerGlobalId
        }]]]></http:query-params>
      </http:request>

      <http:response statusCode="200" doc:name="HTTP Response"/>
      
      <error-handler>
        <on-error-propagate type="HTTP:REQUEST" enableNotifications="true" logException="true" doc:name="HTTP Error">
          <ee:transform doc:name="Transform Error">
            <ee:message>
              <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  error: {
    code: "SERVICE_ERROR",
    message: "An error occurred while fetching credit cards",
    timestamp: now()
  }
}]]></ee:set-payload>
            </ee:message>
          </ee:transform>
          <http:response statusCode="500" doc:name="HTTP Response"/>
        </on-error-propagate>
      </error-handler>
    </try>
  </flow>

  <!-- PUT /cards/{cardGlobalId} - Update Card Controls -->
  <flow name="update-card-controls-flow" doc:name="update-card-controls-flow">
    <http:listener doc:name="PUT /cards/{cardGlobalId}" config-ref="HTTP_Listener_config" path="/api/bank-accounts/cards/{cardGlobalId}" allowedMethods="PUT"/>
    
    <try doc:name="Try">
      <http:request method="PUT" config-ref="Credit_Card_System_API_Config" path="/api/creditcards/cards/{cardGlobalId}" doc:name="Update Card">
        <http:uri-params><![CDATA[#[{cardGlobalId: attributes.uriParams.cardGlobalId}]]]></http:uri-params>
        <http:body><![CDATA[#[payload]]]></http:body>
      </http:request>

      <http:response statusCode="200" doc:name="HTTP Response"/>
      
      <error-handler>
        <on-error-propagate type="HTTP:REQUEST" enableNotifications="true" logException="true" doc:name="HTTP Error">
          <ee:transform doc:name="Transform Error">
            <ee:message>
              <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  error: {
    code: "SERVICE_ERROR",
    message: "An error occurred while updating card controls",
    timestamp: now()
  }
}]]></ee:set-payload>
            </ee:message>
          </ee:transform>
          <http:response statusCode="500" doc:name="HTTP Response"/>
        </on-error-propagate>
      </error-handler>
    </try>
  </flow>

  <!-- POST /sync - Trigger Sync -->
  <flow name="trigger-sync-flow" doc:name="trigger-sync-flow">
    <http:listener doc:name="POST /sync" config-ref="HTTP_Listener_config" path="/api/bank-accounts/sync" allowedMethods="POST"/>
    
    <ee:transform doc:name="Transform Response">
      <ee:message>
        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  message: "Sync request accepted",
  syncId: uuid()
}]]></ee:set-payload>
      </ee:message>
    </ee:transform>

    <http:response statusCode="202" doc:name="HTTP Response"/>
  </flow>

</mule>
